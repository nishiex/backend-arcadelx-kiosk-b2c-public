# API image for the ArcadeLx kiosk backend.
#
# The API imports its Zod schemas through the `@shared-types/*` tsconfig path alias
# (apps/api/tsconfig.json -> ../../packages/shared-types). tsc emits that specifier
# unchanged and there is no `@shared-types` package on disk, so a compiled
# `node dist/...` entrypoint cannot boot; the runtime below stays on tsx, which
# resolves the alias exactly like `npm run dev` does.
#
# Keep WORKDIR at /app/apps/api: the tsconfig paths (`../../packages`) and the
# invoices directory (compose mounts /app/apps/api/invoices) both assume it.

FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages ./packages

RUN npm ci

COPY apps/api ./apps/api

# prisma generate only needs syntactically valid URLs, never a live database.
ENV DATABASE_URL="postgresql://dummy:password@localhost:5432/dummy"
ENV DIRECT_URL="postgresql://dummy:password@localhost:5432/dummy"
RUN cd apps/api && npx prisma generate

# Fail the build on type errors instead of shipping a broken image.
RUN cd apps/api && npx tsc --noEmit

RUN npm prune --omit=dev

FROM node:24-alpine AS runner

WORKDIR /app/apps/api

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0
# Absolute path required by the production env schema; matches the compose bind mount.
ENV INVOICES_DIR=/app/apps/api/invoices

COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/apps/api/package.json ./package.json
COPY --from=builder --chown=node:node /app/apps/api/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=node:node /app/apps/api/src ./src
COPY --from=builder --chown=node:node /app/packages /app/packages

RUN mkdir -p invoices && chown node:node invoices

USER node

EXPOSE 4000

CMD ["/app/node_modules/.bin/tsx", "src/server.ts"]
