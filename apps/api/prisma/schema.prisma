generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  COMPANY
  DISTRIBUTOR
  PARTNER
  IP_PARTY
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
}

// 1 User can only join 1 Organization at a time
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String
  // Required by organization registration; legacy users and staff may omit it.
  contact      String? @unique @db.VarChar(10)

  // Set for accounts created with a temporary password (IP parties); cleared on first change.
  mustChangePassword Boolean @default(false)

  membership Membership?

  // Organizations owned by this user
  ownedOrganizations   Organization[]    @relation("OrganizationOwner")
  tokens               RefreshToken[]
  kioskAssignmentsMade KioskAssignment[] // Assignments made to a organization

  // Return requests this user raised for a kiosk owned by their organization.
  kioskReturnRequests KioskReturnRequest[]

  passwordResets PasswordReset[]

  devicePriceRequests   DevicePriceRequest[] @relation("DevicePriceRequestRequester")
  reviewedPriceRequests DevicePriceRequest[] @relation("DevicePriceRequestReviewer")
  eodDevicePriceUpdates EodDevicePriceUpdate[] @relation("EodDevicePriceUpdateCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Short-lived verification requests for phone ownership checks. The phone is
// intentionally kept independent from User so registration can verify a
// number before an account exists.
model PhoneVerification {
  id         String   @id @default(uuid())
  phone      String   @db.VarChar(16)
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([phone, createdAt])
}

model PasswordReset {
  id     String @id @default(uuid())
  userId String

  otpHash    String
  resetToken String? @unique

  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id          String  @id @default(uuid())
  ownerId     String
  parentOrgId String?

  name      String
  type      OrgType
  state     String
  city      String
  pincode   Int
  address   String
  gstNumber String? @db.VarChar(30)
  phone     String? @db.VarChar(32)
  country   String? @db.VarChar(100)

  isActive      Boolean @default(true)
  accessVersion Int     @default(0)

  inviteCode          String?   @unique
  inviteCodeExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id])
  memberships Membership[]

  parentOrg Organization?  @relation("OrganizationParent", fields: [parentOrgId], references: [id])
  childOrgs Organization[] @relation("OrganizationParent")

  initiatedConnections NetworkConnection[] @relation("InitiatorOrg")
  receivedConnections  NetworkConnection[] @relation("ReceiverOrg")

  parentAgreements Agreement[] @relation("ParentAgreements")
  childAgreements  Agreement[] @relation("ChildAgreements")

  kioskReturnRequests KioskReturnRequest[]
  kiosks              Kiosk[]
  kioskAssignments    KioskAssignment[]
  ordersAsParent      Order[]              @relation("OrderParent")
  ordersAsChild       Order[]              @relation("OrderChild")
  emailDeliveries     EmailDelivery[]
  revenueStatements   RevenueStatement[]
  devicePriceRequests DevicePriceRequest[] @relation("DevicePriceRequestOrganization")
  ads                 Ad[]

  ipProfile             IpProfile?
  ipAgreements          IpAgreement[]        @relation("IpPartyAgreements")
  companyIpAgreements   IpAgreement[]        @relation("CompanyAgreements")
  ipGames               IpGame[]
  ipSplits              TransactionSplit[]   @relation("IpPartySplits")
  ipSettlements         IpSettlement[]
  ipDailyRevenues       IpDailyGameRevenue[]
  ipDailyGameKiosks     IpDailyGameKiosk[]
  ipDailyPartySummaries IpDailyPartySummary[]

  @@index([parentOrgId])
}

model Membership {
  id             String @id @default(uuid())
  userId         String @unique
  organizationId String

  role   Role?
  status MembershipStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AuditLog {
  id                  String   @id @default(uuid())
  actorUserId         String?
  actorOrganizationId String?
  actorName           String
  actorOrgType        OrgType?
  actorOrgName        String?
  action              String   @db.VarChar(64)
  entity              String   @db.VarChar(64)
  reference           String?
  detail              String?  @db.Text
  method              String   @db.VarChar(10)
  path                String   @db.VarChar(500)
  statusCode          Int
  status              String   @db.VarChar(16)
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([actorOrganizationId, createdAt])
  @@index([entity, action, createdAt])
}

// Mothership currently supports disabling gateways but not deleting them. This
// tombstone makes a removal permanent in our application layer across restarts
// and serverless cold starts.
model RemovedGateway {
  provider  String   @id @db.VarChar(64)
  removedAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum NetworkStatus {
  PENDING
  ACTIVE
}

model NetworkConnection {
  id             String        @id @default(uuid())
  initiatorOrgId String
  receiverOrgId  String
  status         NetworkStatus @default(PENDING) //PENDING,ACTIVE

  createdAt DateTime @default(now()) // Added
  updatedAt DateTime @updatedAt // Added

  initiator Organization @relation("InitiatorOrg", fields: [initiatorOrgId], references: [id])
  reciever  Organization @relation("ReceiverOrg", fields: [receiverOrgId], references: [id])

  agreements Agreement[]
}

enum AgreementStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  TERMINATED
}

model Agreement {
  id                  String @id @default(uuid())
  networkConnectionId String

  parentOrgId String
  childOrgId  String

  parentSharePct Decimal @db.Decimal(5, 2)
  childSharePct  Decimal @db.Decimal(5, 2)

  effectiveFrom                 DateTime
  effectiveTo                   DateTime?
  status                        AgreementStatus @default(DRAFT)
  pdfUrl                        String?
  depositAmountPerMachine       Int
  nonRefundableAmountPerMachine Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  networkConnection NetworkConnection @relation(fields: [networkConnectionId], references: [id])

  parentOrg Organization @relation("ParentAgreements", fields: [parentOrgId], references: [id])

  childOrg Organization @relation("ChildAgreements", fields: [childOrgId], references: [id])

  orders Order[]

  distributorSplits TransactionSplit[] @relation("DistributorSplits")
  partnerSplits     TransactionSplit[] @relation("PartnerSplits")
}

enum KioskStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  INSTALLED
  MAINTENANCE
  RETURNED
  RETIRED
  // Added by the Backend branch's return-request flow. Kept alongside RETIRED rather
  // than replacing it: the frontend still lists RETIRED as a real kiosk status.
  RETURN_REQUESTED
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
}

model Kiosk {
  id               String      @id @default(uuid())
  machineCode      String      @unique //eg:ADLX-2026-A048
  model            String
  status           KioskStatus @default(AVAILABLE)
  location         String?
  externalDeviceId String?     @unique // Mothership's UUID (The Link)

  currentOrgId    String?
  reservedOrderId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  currentOrg     Organization?        @relation(fields: [currentOrgId], references: [id])
  assignments    KioskAssignment[]
  orderKiosks    OrderKiosk[]
  transactions   Transaction[]
  reservedOrder  Order?               @relation("ReservedKiosks", fields: [reservedOrderId], references: [id], onDelete: Restrict)
  returnRequests KioskReturnRequest[]
  adKiosks       AdKiosk[]
}

// A kiosk owner asking to hand a machine back, and the supplier's decision on it.
// Ported from the Backend branch. Kept separate from KioskStatus history: the request
// carries its own status so a decision is auditable after the kiosk moves on.
model KioskReturnRequest {
  id             String @id @default(uuid())
  kioskId        String
  organizationId String
  requestedById  String

  status ReturnRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kiosk        Kiosk        @relation(fields: [kioskId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  requestedBy  User         @relation(fields: [requestedById], references: [id])

  @@index([kioskId, status])
}

// audit/history ledger for kiosk ownership/assignment movement.
model KioskAssignment {
  id             String  @id @default(uuid())
  kioskId        String
  organizationId String
  orderId        String?
  assignedById   String // The User ID who made the assignment

  assignedFrom DateTime  @default(now())
  assignedTo   DateTime? // Null means currently active

  kiosk        Kiosk        @relation(fields: [kioskId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  assignedBy   User         @relation(fields: [assignedById], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  splits       TransactionSplit[]

  @@index([kioskId, assignedTo])
  @@index([organizationId, assignedTo])
}

model MachineSequence {
  year  Int @id
  value Int @default(0)
}

model OrderSequence {
  year  Int @id
  value Int @default(0)
}

// Payloads are authenticated-encrypted. Sent credentials are erased after delivery.
model EmailDelivery {
  id                  String       @id @default(uuid())
  key                 String       @unique
  kind                String
  ownerOrganizationId String
  payload             String
  attempts            Int          @default(0)
  leaseId             String?
  lockedUntil         DateTime?
  sentAt              DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  ownerOrganization   Organization @relation(fields: [ownerOrganizationId], references: [id])
}

enum OrderType {
  REQUEST // Distributor asks Company
  ALLOCATION // Parent proactively pushes to Child
}

enum OrderStatus {
  UNDER_REVIEW
  APPROVED
  DISPATCHED
  DELIVERED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  CASH
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique // e.g., ORD-2026-0001
  type          OrderType
  status        OrderStatus   @default(UNDER_REVIEW)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?

  parentOrgId String
  childOrgId  String
  agreementId String

  quantity                Int
  requestedModel          String?
  depositPerMachine       Float
  nonRefundablePerMachine Float

  // For current orders this is the gross collection, including the fee and GST;
  // legacy rows may retain the former refundable-deposit meaning.
  totalDeposit       Float
  totalNonRefundable Float // Without tax
  taxAmount          Float // GST on the totalDeposit (gross collection)
  // Current orders equal totalDeposit; legacy rows retain the additive total.
  grandTotal         Float

  invoiceUrl      String? // Path to the VPS file
  invoiceFilename String?

  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?
  paidAt            DateTime?
  cashPaymentRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentOrg Organization @relation("OrderParent", fields: [parentOrgId], references: [id])
  childOrg  Organization @relation("OrderChild", fields: [childOrgId], references: [id])
  agreement Agreement    @relation(fields: [agreementId], references: [id])

  dispatchedKiosks OrderKiosk[]
  kioskAssignments KioskAssignment[]
  reservedKiosks   Kiosk[]           @relation("ReservedKiosks")
}

// Kiosks reserved for an order during APPROVED state.
// These become ASSIGNED when the order is dispatched.
model OrderKiosk {
  orderId String
  kioskId String

  order Order @relation(fields: [orderId], references: [id])
  kiosk Kiosk @relation(fields: [kioskId], references: [id])

  @@id([orderId, kioskId])
}

// PHASE 5: Revenue Tracking Models
model Transaction {
  id                    String  @id @default(uuid())
  kioskId               String
  gameId                String
  // Upstream attribution key (IP source), null for legacy transactions.
  source                String?
  amount                Decimal @db.Decimal(10, 2)
  currency              String  @default("INR")
  externalTransactionId String  @unique // Maps to 'txnid'

  // Store the upstream instant with its timezone so reports do not depend on the API host timezone.
  occurredAt DateTime @db.Timestamptz(3) // Maps to 'updated_at'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kiosk Kiosk             @relation(fields: [kioskId], references: [id])
  split TransactionSplit?

  @@index([kioskId, occurredAt])
  @@index([source, occurredAt])
}

enum SyncStatus {
  SUCCESS
  FAILED
}

enum DevicePriceRequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

enum EodDevicePriceStatus {
  PENDING
  PROCESSING
  APPLIED
  FAILED
}

model EodDevicePriceUpdate {
  id                    String              @id @default(uuid())
  deviceId              String
  gameId                String
  displayName           String
  businessDate          DateTime            @db.Date
  scheduledTime         String              @default("00:00") @db.VarChar(5)
  price                 Decimal             @db.Decimal(10, 2)
  replayPrice           Decimal             @db.Decimal(10, 2)
  status                EodDevicePriceStatus @default(PENDING)
  attempts              Int                 @default(0)
  processingAt          DateTime?
  appliedAt             DateTime?
  verifiedPrice         Decimal?            @db.Decimal(10, 2)
  verifiedReplayPrice   Decimal?            @db.Decimal(10, 2)
  lastError             String?             @db.Text
  createdById           String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  createdBy User @relation("EodDevicePriceUpdateCreator", fields: [createdById], references: [id])

  @@unique([deviceId, gameId, businessDate])
  @@index([status, businessDate])
  @@index([deviceId, gameId, status])
}

model DevicePriceRequest {
  id             String                   @id @default(uuid())
  deviceId       String
  gameId         String
  displayName    String
  price          Decimal                  @db.Decimal(10, 2)
  replayPrice    Decimal                  @db.Decimal(10, 2)
  requesterOrgId String
  requestedById  String
  status         DevicePriceRequestStatus @default(PENDING)
  processingAt   DateTime?
  reviewNote     String?                  @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  requesterOrg Organization @relation("DevicePriceRequestOrganization", fields: [requesterOrgId], references: [id])
  requestedBy  User         @relation("DevicePriceRequestRequester", fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("DevicePriceRequestReviewer", fields: [reviewedById], references: [id])

  @@index([requesterOrgId, status])
  @@index([status, createdAt])
}

model RevenueSyncRunLog {
  id    String   @id @default(uuid())
  runAt DateTime @default(now())

  totalRecordsFetched Int @default(0)
  newRecordsInserted  Int @default(0)
  unattributedCount   Int @default(0) // Records where device_id didn't match a Kiosk
  unmappedSourceCount Int @default(0) // Records whose source matched no IpProfile
  unsplitCount        Int @default(0) // Records that could not be split

  status       SyncStatus
  errorMessage String?    @db.Text

  createdAt DateTime @default(now())
}

//Company can modify these values according to the law and the third party payment
model SystemSettings {
  id              String   @id @default("default")
  gstPercentage   Decimal  @default(18.00) @db.Decimal(5, 2)
  pgFeePercentage Decimal  @default(2.50) @db.Decimal(5, 2)
  tdsPercentage   Decimal  @default(2.00) @db.Decimal(5, 2)
  updatedAt       DateTime @updatedAt
}

enum StatementStatus {
  GENERATED
  PAID
}

model RevenueStatement {
  id               String  @id @default(uuid())
  organizationId   String
  Month            Int
  Year             Int
  GrossRevenue     Decimal @db.Decimal(12, 2)
  netRevenue       Decimal @db.Decimal(12, 2)
  companyShare     Decimal @db.Decimal(12, 2)
  distributorShare Decimal @db.Decimal(12, 2)
  partnerShare     Decimal @db.Decimal(12, 2)
  tdsAmount        Decimal @db.Decimal(12, 2)
  finalPayout      Decimal @db.Decimal(12, 2)

  pdfPath String
  status  StatementStatus @default(GENERATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // DB-level duplicate-prevention safety net
  @@unique([organizationId, Month, Year])
}

// ── Ads Module ──────────────────────────────────────────────────────────────────
// Company-level video ads that can be pushed to one or more kiosks.

enum AdStatus {
  ACTIVE
  INACTIVE
}

model Ad {
  id               String   @id @default(uuid())
  organizationId   String
  title            String   @db.VarChar(200)
  description      String?  @db.Text
  videoFilename    String   @unique @db.VarChar(500)   // server-minted filename on disk
  originalFilename String   @db.VarChar(500)   // upload name shown to the user
  mimeType         String   @db.VarChar(100)   // validated at upload; replayed on playback
  videoSizeBytes   Int                          // exact byte-length; Int covers the 500 MB cap
  durationSeconds  Float?                       // optional client hint, never trusted for billing
  status           AdStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  adKiosks     AdKiosk[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// Many-to-many join: which kiosks currently carry which ad.
model AdKiosk {
  adId    String
  kioskId String

  assignedAt DateTime @default(now())

  ad    Ad    @relation(fields: [adId], references: [id], onDelete: Cascade)
  kiosk Kiosk @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@id([adId, kioskId])
  // Postgres does not index foreign keys; this one is scanned by kiosk deletes, the
  // ownership-transfer flow and the per-kiosk playback feed.
  @@index([kioskId])
}

// IP MODELS 

model IpProfile {
  id             String  @id @default(uuid())
  organizationId String  @unique
  sourceKey      String  @unique //Example:nilee-games, neela-productions,disney-media etc
  legalName      String
  pan            String
  gstin          String?
  statementEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([sourceKey])
}

enum IpAgreementStatus {
  DRAFT
  ACTIVE
  TERMINATED
}

//Always to be initiated by the company , the Ip has read only access, no approavkl , or anything , directly company could make an agreement for the IP
model IpAgreement {
  id                    String            @id @default(uuid())
  organizationId        String
  companyOrganizationId String?
  ipSharePct            Decimal           @db.Decimal(5, 2)
  companySharePct       Decimal           @db.Decimal(5, 2)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  status                IpAgreementStatus @default(DRAFT)
  contractPdfUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization       @relation("IpPartyAgreements", fields: [organizationId], references: [id], onDelete: Restrict)
  companyOrganization Organization?      @relation("CompanyAgreements", fields: [companyOrganizationId], references: [id], onDelete: SetNull)
  transactionSplits   TransactionSplit[]

  @@index([organizationId, status])
  @@index([organizationId, effectiveFrom])
  @@index([companyOrganizationId])
}

enum IpGameStatus {
  ACTIVE
  INACTIVE
}

//Company will register a game , for each IP to showcase on the IP Dashboard
model IpGame {
  id             String       @id @default(uuid())
  organizationId String
  gameIdentifier String       @unique// example: jetha-ka-tadka (Write as slug, Frotned should make sure the input is converted to slug automatically)
  displayName    String
  coverImageUrl  String?
  launchDate     DateTime?
  status         IpGameStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactionSplits TransactionSplit[]
  settlementLines   IpSettlementLine[]
  dailyRevenues     IpDailyGameRevenue[]

  @@index([organizationId, status])
}

enum SplitStatus {
  PENDING
  RESOLVED
  UNRESOLVED
}

// This model will be implemented for each transaction ,as this is neccesary ,for CA and for IP to show splits on their dashboards
model TransactionSplit {
  id            String   @id @default(uuid())
  transactionId String   @unique
  businessDate  DateTime @db.Date // DateTime @db.Date stores a date, not a timezone. The future calculation service must explicitly derive the business date in IST from the transaction timestamp. The schema alone cannot guarantee this.

  // Deductions snapshot
  grossAmount Decimal  @db.Decimal(10, 2)
  gstAmount   Decimal? @db.Decimal(10, 2)
  pgFeeAmount Decimal? @db.Decimal(10, 2)
  netAmount   Decimal? @db.Decimal(10, 2)

  // Network allocations snapshot
  distributorShare Decimal? @db.Decimal(10, 2)
  partnerShare     Decimal? @db.Decimal(10, 2)
  companyShare     Decimal? @db.Decimal(10, 2)

  // IP Royalty allocation (if applicable)
  isIpTransaction      Boolean  @default(false)
  ipOrganizationId     String?
  ipGameId             String?
  ipAgreementId        String?
  ipSharePct           Decimal? @db.Decimal(5, 2)
  ipShare              Decimal? @db.Decimal(10, 2)
  companyRetainedShare Decimal? @db.Decimal(10, 2)

  // Audit references
  kioskAssignmentId      String?
  distributorAgreementId String?
  partnerAgreementId     String?

  // Resolution status & exception tracking
  status           SplitStatus @default(PENDING)
  unresolvedReason String?     @db.Text
  calculatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transaction          Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  kioskAssignment      KioskAssignment? @relation(fields: [kioskAssignmentId], references: [id], onDelete: SetNull)
  distributorAgreement Agreement?       @relation("DistributorSplits", fields: [distributorAgreementId], references: [id], onDelete: SetNull)
  partnerAgreement     Agreement?       @relation("PartnerSplits", fields: [partnerAgreementId], references: [id], onDelete: SetNull)
  ipOrganization       Organization?    @relation("IpPartySplits", fields: [ipOrganizationId], references: [id], onDelete: SetNull)
  ipGame               IpGame?          @relation(fields: [ipGameId], references: [id], onDelete: SetNull)
  ipAgreement          IpAgreement?     @relation(fields: [ipAgreementId], references: [id], onDelete: SetNull)

  @@index([businessDate])
  @@index([ipOrganizationId, businessDate])
  @@index([ipGameId, businessDate])
  @@index([status])
}

enum IpSettlementStatus {
  GENERATED
  PAID
}

//Monthly aggregated settlement header for an IP organization.
model IpSettlement {
  id             String @id @default(uuid())
  organizationId String
  month          Int
  year           Int

  grossRevenue              Decimal  @db.Decimal(12, 2)
  gstAmount                 Decimal  @db.Decimal(12, 2)
  pgFeeAmount               Decimal  @db.Decimal(12, 2)
  networkShare              Decimal  @db.Decimal(12, 2) //Distributor and partners Share
  companyShareBeforeRoyalty Decimal  @db.Decimal(12, 2)
  ipRoyaltyShare            Decimal  @db.Decimal(12, 2)
  totalKioskCount           Int      @default(0)
  finalPayout               Decimal? @db.Decimal(12, 2)

  pdfPath          String?
  status           IpSettlementStatus @default(GENERATED)
  emailDeliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        IpSettlementLine[]

  @@unique([organizationId, month, year])
  @@index([organizationId, year, month])
}

// Game-level rows for the monthly settlement statement.
model IpSettlementLine {
  id           String  @id @default(uuid())
  settlementId String
  ipGameId     String?

  gameIdentifier  String
  gameDisplayName String
  kioskCount      Int

  grossRevenue              Decimal @db.Decimal(12, 2)
  gstAmount                 Decimal @db.Decimal(12, 2)
  pgFeeAmount               Decimal @db.Decimal(12, 2)
  networkShare              Decimal @db.Decimal(12, 2)
  companyShareBeforeRoyalty Decimal @db.Decimal(12, 2)
  ipRoyaltyShare            Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlement IpSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  ipGame     IpGame?      @relation(fields: [ipGameId], references: [id], onDelete: SetNull)

  @@unique([settlementId, gameIdentifier])
}

// Daily aggregated revenue snapshot per game for an IP Party organization.
model IpDailyGameRevenue {
  id             String    @id @default(uuid())
  organizationId String
  ipGameId       String?
  businessDate   DateTime  @db.Date
  gameIdentifier String
  gameDisplayName String
  kioskCount     Int       @default(0)

  grossRevenue              Decimal  @db.Decimal(12, 2)
  gstAmount                 Decimal  @db.Decimal(12, 2)
  pgFeeAmount               Decimal  @db.Decimal(12, 2)
  networkShare              Decimal  @db.Decimal(12, 2) // Distributor and Partner combined share
  companyShareBeforeRoyalty Decimal  @db.Decimal(12, 2)
  ipRoyaltyShare            Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ipGame       IpGame?      @relation(fields: [ipGameId], references: [id], onDelete: SetNull)

  @@unique([organizationId, businessDate, gameIdentifier])
  @@index([organizationId, businessDate])
  @@index([businessDate])
  @@index([ipGameId])
}

// Daily recording of distinct physical kiosks active per game for an IP Party.
// Enables monthly settlement to compute distinct physical kiosks without querying TransactionSplit.
model IpDailyGameKiosk {
  id             String   @id @default(uuid())
  organizationId String
  businessDate   DateTime @db.Date
  gameIdentifier String
  kioskId        String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, businessDate, gameIdentifier, kioskId])
  @@index([organizationId, businessDate])
  @@index([organizationId, gameIdentifier])
}

// Daily aggregated summary per IP Party organization.
model IpDailyPartySummary {
  id             String    @id @default(uuid())
  organizationId String
  businessDate   DateTime  @db.Date
  kioskCount     Int       @default(0)

  grossRevenue              Decimal  @db.Decimal(12, 2)
  gstAmount                 Decimal  @db.Decimal(12, 2)
  pgFeeAmount               Decimal  @db.Decimal(12, 2)
  networkShare              Decimal  @db.Decimal(12, 2)
  companyShareBeforeRoyalty Decimal  @db.Decimal(12, 2)
  ipRoyaltyShare            Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, businessDate])
  @@index([organizationId, businessDate])
  @@index([businessDate])
}

enum IpDailyJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

// Tracking model for daily revenue aggregation job runs.
model IpDailyRevenueJobRun {
  id             String           @id @default(uuid())
  businessDate   DateTime         @db.Date
  status         IpDailyJobStatus @default(PENDING)
  startedAt      DateTime         @default(now())
  completedAt    DateTime?

  // First-class concurrency & lease control fields for atomic updates
  leaseToken      String?
  leaseExpiresAt  DateTime?
  lastHeartbeatAt DateTime?

  partiesDiscovered           Int      @default(0)
  partiesProcessed            Int      @default(0)
  batchesTotal                Int      @default(0)
  batchesSuccessful           Int      @default(0)
  batchesFailed               Int      @default(0)
  splitsConsidered            Int      @default(0)
  unresolvedSplitsExcluded    Int      @default(0)
  missingGameAttributionCount Int      @default(0)
  recordsCreatedOrUpdated     Int      @default(0)

  errorMessage String? @db.Text
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessDate, status])
  @@index([leaseExpiresAt])
}
