# Copy to .env for local development; inject settings through your host in production.
NODE_ENV=development
PORT=4000
BUSINESS_TIMEZONE=Asia/Kolkata
EOD_PRICE_JOBS_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate independent secrets. Keep INTERNAL_API_SECRET stable while email jobs are pending.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_SECRET_TOKEN=
REFRESH_SECRET_TOKEN=
INTERNAL_API_SECRET=
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=7d

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ArcadeLX
FRONTEND_LOGIN_URL=http://localhost:3000/login

# Production: NODE_ENV=production, an HTTPS login URL, and an absolute persistent invoice path.
# Linux example: INVOICES_DIR=/var/lib/arcadelx/invoices
# Windows example: INVOICES_DIR=C:/arcadelx-data/invoices
# INVOICES_DIR=

# One-time company setup, used only when the database has no COMPANY.
# Set real values in ignored .env or deployment secrets before prisma db seed.
# Existing company/user/password records are never overwritten by the seed.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
# Minimum 8 characters, maximum 72 UTF-8 bytes. Never printed by seed.
SEED_OWNER_PASSWORD=
SEED_COMPANY_NAME=
SEED_COMPANY_STATE=
SEED_COMPANY_CITY=
SEED_COMPANY_PINCODE=
SEED_COMPANY_ADDRESS=

# Frontend build/start environment (also set in its hosting project):
# BACKEND_API_URL=https://your-api-host.example

# Enable with a migrated database and configured services.
REVENUE_JOBS_ENABLED=false
REDIS_URL=redis://localhost:6379
MOTHERSHIP_TRANSACTION_API_URL=https://main.arcadelx.games/api/v1/payments
MOTHERSHIP_ANALYTICS_SUMMARY_URL=https://main.arcadelx.games/api/v1/analytics/summary
# Local development only. Never enable this in production.
LOCAL_DATABASE_WIPE_ENABLED=false
# Absolute persistent report directory (required for production jobs).
# REVENUE_REPORTS_DIR=

# Device feed used by the sync to register kiosks and pair externalDeviceId.
MOTHERSHIP_DEVICE_API_URL=https://your-configured-source/devices

# Payment-gateway admin API, proxied by /api/admin/gateways (COMPANY OWNER/ADMIN only).
# Optional: set the Mothership host or any full Mothership API endpoint URL;
# the backend uses its origin and appends the canonical /api/v1/admin/gateways route.
MOTHERSHIP_ADMIN_API_URL=
# Optional: sent as X-Admin-Api-Key. Mothership currently answers the gateway admin
# API without credentials, so leave empty unless that changes.
MOTHERSHIP_ADMIN_API_KEY=

# Base32 secret for Google Authenticator. Required before disabling or removing a gateway.
# Generate a secret with a trusted password manager or `openssl rand -base64 20` converted
# to base32, then add it to Google Authenticator as an ArcadeLX TOTP account.
GATEWAY_TOTP_SECRET=

# WhatsApp OTP testing through Twilio WhatsApp Sandbox or a production sender.
# Use E.164 format for the sender, for example: +14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
