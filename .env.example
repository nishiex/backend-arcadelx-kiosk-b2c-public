# Copy to .env for local development; inject settings through your host in production.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate independent secrets. Keep INTERNAL_API_SECRET stable while email jobs are pending.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_SECRET_TOKEN=
REFRESH_SECRET_TOKEN=
INTERNAL_API_SECRET=
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=7d

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ArcadeLX
FRONTEND_LOGIN_URL=http://localhost:3000/login

# Production: NODE_ENV=production, an HTTPS login URL, and an absolute persistent invoice path.
# Linux example: INVOICES_DIR=/var/lib/arcadelx/invoices
# Windows example: INVOICES_DIR=C:/arcadelx-data/invoices
# INVOICES_DIR=

# One-time company setup, used only when the database has no COMPANY.
# Set real values in ignored .env or deployment secrets before prisma db seed.
# Existing company/user/password records are never overwritten by the seed.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
# Minimum 8 characters, maximum 72 UTF-8 bytes. Never printed by seed.
SEED_OWNER_PASSWORD=
SEED_COMPANY_NAME=
SEED_COMPANY_STATE=
SEED_COMPANY_CITY=
SEED_COMPANY_PINCODE=
SEED_COMPANY_ADDRESS=

# Frontend build/start environment (also set in its hosting project):
# BACKEND_API_URL=https://your-api-host.example

