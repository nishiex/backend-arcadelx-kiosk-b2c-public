# Copy to .env for local development; inject settings through your host in production.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate independent secrets. Keep INTERNAL_API_SECRET stable while email jobs are pending.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_SECRET_TOKEN=
REFRESH_SECRET_TOKEN=
INTERNAL_API_SECRET=
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=7d

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ArcadeLX
FRONTEND_LOGIN_URL=http://localhost:3000/login

# Production: NODE_ENV=production, an HTTPS login URL, and an absolute persistent invoice path.
# Linux example: INVOICES_DIR=/var/lib/arcadelx/invoices
# Windows example: INVOICES_DIR=C:/arcadelx-data/invoices
# INVOICES_DIR=

# Frontend build/start environment (also set in its hosting project):
# BACKEND_API_URL=https://your-api-host.example

