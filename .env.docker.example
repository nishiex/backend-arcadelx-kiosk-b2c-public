# Template for the Docker deployment. Copy to `.env` on the server, then fill every
# blank value. Never commit the filled file; real secrets stay on the host.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Supabase: transaction-mode pooler for runtime, session-mode pooler for migrations.
# Keep the existing database configuration; no local database service is added.
DATABASE_URL=postgresql://postgres.vsednsppdlbcensnvwxq:REPLACE_WITH_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.vsednsppdlbcensnvwxq:REPLACE_WITH_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"   # 64-byte
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # 32-byte
ACCESS_SECRET_TOKEN=
REFRESH_SECRET_TOKEN=
INTERNAL_API_SECRET=
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=7d

# Invoice storage. Must match the bind mount in docker-compose.mothership.yml:
#   ./apps/api/invoices -> /app/apps/api/invoices
# Absolute path: production validation rejects relative paths.
INVOICES_DIR=/app/apps/api/invoices

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=verified-sender@example.com
MAIL_FROM_NAME=ArcadeLx

# https is required whenever NODE_ENV=production.
FRONTEND_LOGIN_URL=https://main.arcadelx.games/login
CORS_ORIGINS=https://main.arcadelx.games

BUSINESS_TIMEZONE=Asia/Kolkata
EOD_PRICE_RUN_TIME=00:00
EOD_PRICE_JOBS_ENABLED=false
EOD_REDIS_WORKER_ENABLED=false

# Destructive endpoints must stay off on a shared server.
LOCAL_DATABASE_WIPE_ENABLED=false
EOD_ALLOW_UNAUTHENTICATED_TESTS=false

# Only needed when EOD_REDIS_WORKER_ENABLED=true.
# REDIS_URL=redis://redis:6379
